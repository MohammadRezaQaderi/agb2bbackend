AG_ENV=development

# File storage
AG_BASE_PATH=D:/WebSites/TestProjects
AG_INS_PIC_DIR=D:/WebSites/TestProjects/Media/InsPic
AG_VOICES_DIR=D:/WebSites/TestProjects/Voices
AG_REPORTS_DIR=D:/WebSites/TestProjects/Reports
AG_REPORT_OUTPUT_DIR=D:/WebSites/TestProjects/Reports/exports

# SMS / OTP
AG_KAVENEGAR_API_KEY=
AG_KAVENEGAR_OTP_TEMPLATE=AGOTP
AG_OTP_TTL_SECONDS=300

# Reversible password encryption. Generate a key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AG_PASSWORD_SECRET_KEY=

# SQL Server
AG_DB_DRIVER=ODBC Driver 17 for SQL Server
AG_DB_SERVER=localhost,1433
AG_DB_DATABASE=AGB2B_COPY
AG_DB_UID=
AG_DB_PWD=
AG_DB_TRUST_CERT=yes

# Redis
AG_REDIS_HOST=127.0.0.1
AG_REDIS_PORT=6379
AG_REDIS_PASSWORD=
AG_REDIS_DB=1
AG_REDIS_CACHE_OTP=verify_cache_AG
AG_REDIS_QUEUE_NAME=userAGB2BReport
AG_HEALTH_CHECK_REDIS=0

# Optional monitoring Compose stack
GRAFANA_ADMIN_PASSWORD=

# Report defaults
AG_REPORT_DEFAULT_INS_ID=7017
AG_REPORT_DEFAULT_CON_ID=11359
