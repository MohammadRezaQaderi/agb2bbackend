{
  "host": "0.0.0.0",
  "default_workers": 2,
  "services": {
    "ag_api": {
      "health_check_path": "/ag_api/health",
      "instances": [
        {
          "name": "ag-test-api-primary-1",
          "port": 5559,
          "workers": 2,
          "description": "AG management API instance"
        }
      ]
    },
    "ags_api": {
      "health_check_path": "/ags_api/health",
      "instances": [
        {
          "name": "ags-test-student-api-primary-1",
          "port": 5560,
          "workers": 2,
          "description": "AG student API instance"
        }
      ]
    }
  },
  "health_check_interval": 30000,
  "health_check_timeout": 5000,
  "max_restarts": 10,
  "restart_delay": 5000
}
