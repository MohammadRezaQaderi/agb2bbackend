      "request": {
        "method": "POST",
        "header": [
          {"key": "Content-Type", "value": "application/json", "type": "text"}
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{token}}\",\n  \"action_type\": \"ag_change_capacity\",\n  \"request_data\": {\n    \"phone\": \"09123456789\",\n    \"kind\": \"AG\",\n    \"count\": 10\n  }\n}",
          "options": {"raw": {"language": "json"}}
        },
        "url": {
          "raw": "{{url}}/ag_api/admin_request",
          "host": ["{{url}}"],
          "path": ["ag_api", "admin_request"]
        },
        "description": "Add capacity for an institute, school, or owner consultant."
      },
      "response": []
    },
    {
